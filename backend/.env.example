APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# El esquema lo construyen los scripts de database/sql/, no las migraciones, y
# RLS es de PostgreSQL: sqlite no vale ni para desarrollo ni para los tests.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1

# Tiene que coincidir con el DB_PORT del .env de la raiz, que es el puerto que
# publica Docker. Si no coinciden: SQLSTATE[08006] ... Connection refused.
DB_PORT=5432
DB_DATABASE=mts_platform

# mts_app, NUNCA mts_user. mts_user es superusuario y los superusuarios ignoran
# RLS siempre: con el, el aislamiento entre empresas deja de aplicarse en
# silencio, sin ningun error que lo delate.
DB_USERNAME=mts_app
DB_PASSWORD=

# 'prefer' en local (el Postgres de Docker no tiene TLS). En produccion,
# 'require': con 'prefer', si falla la negociacion TLS la conexion sigue en
# claro sin avisar.
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================
# MTS Platform
# ==========================================

# Origenes que pueden llamar a la API, separados por comas. Sin esto Laravel
# aceptaria peticiones desde cualquier web. En produccion hay que definirlo.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# El alta de clientes se hace desde el back-office. En true, POST /api/register
# se reabre y cualquiera en internet podria crear una empresa.
MTS_SELF_REGISTRATION=false

# Slug de la tabla plans que se asigna cuando nadie elige plan.
MTS_DEFAULT_PLAN=starter
