APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# El esquema lo construyen los scripts de database/sql/, no las migraciones, y
# RLS es de PostgreSQL: sqlite no vale ni para desarrollo ni para los tests.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1

# Tiene que coincidir con el DB_PORT del .env de la raiz, que es el puerto que
# publica Docker. Si no coinciden: SQLSTATE[08006] ... Connection refused.
DB_PORT=5432
DB_DATABASE=mts_platform

# mts_app, NUNCA mts_user. mts_user es superusuario y los superusuarios ignoran
# RLS siempre: con el, el aislamiento entre empresas deja de aplicarse en
# silencio, sin ningun error que lo delate.
DB_USERNAME=mts_app
DB_PASSWORD=

# 'prefer' en local (el Postgres de Docker no tiene TLS). En produccion,
# 'require': con 'prefer', si falla la negociacion TLS la conexion sigue en
# claro sin avisar.
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================
# MTS Platform
# ==========================================

# Origenes que pueden llamar a la API, separados por comas. Sin esto Laravel
# aceptaria peticiones desde cualquier web. En produccion hay que definirlo.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# El alta de clientes se hace desde el back-office. En true, POST /api/register
# se reabre y cualquiera en internet podria crear una empresa.
MTS_SELF_REGISTRATION=false

# Slug de la tabla plans que se asigna cuando nadie elige plan.
MTS_DEFAULT_PLAN=starter

# ------------------------------------------
# Donde se guardan las fotos de producto
# ------------------------------------------
# 'public' en local: una carpeta, sin depender de la red ni de credenciales.
# 'r2' en produccion, porque Cloud Run tiene disco efimero y las fotos
# desaparecerian en el primer redespliegue.
MTS_MEDIA_DISK=public

# ------------------------------------------
# Cloudflare R2 (solo hace falta con MTS_MEDIA_DISK=r2)
# ------------------------------------------
# Se crean en R2 -> Manage API tokens. El token necesita permiso de
# LECTURA Y ESCRITURA sobre el bucket: con uno de solo lectura, la
# importacion falla archivo a archivo.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mts-platform-media

# Endpoint PRIVADO de la API S3, el que usa el backend para escribir.
# Formato: https://<ID-DE-CUENTA>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Direccion PUBLICA por la que el navegador pide las fotos. NO pongas aqui el
# endpoint de arriba: es privado y devolveria 401 en cada imagen del catalogo.
#
# Dos opciones:
#   - https://pub-XXXX.r2.dev  el dominio de desarrollo de R2. Se activa en un
#     clic desde el panel del bucket, sin tocar ningun DNS.
#   - https://img.tudominio.com  un dominio propio conectado al bucket. Mejor
#     para produccion, pero la zona tiene que estar en la misma cuenta de
#     Cloudflare.
#
# Cambiar de uno a otro es editar solo esta linea: la direccion publica no se
# guarda en media.path, se construye al vuelo con Storage::url().
R2_URL=
