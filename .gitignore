# Entorno
# Por patron y no por nombre: el repo es publico, y cualquier .env nuevo
# (.env.neon, .env.produccion, .env.local...) llevaria credenciales reales.
# Ignorar de mas es gratis; olvidarse de uno se paga con una fuga.
.env
.env.*
!.env.example

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/.env
backend/storage/*.key
backend/bootstrap/cache/*

# Frontend (React)
frontend/node_modules/
frontend/dist/
frontend/.env

# Docker
docker/postgres/data/

# Sistema
.DS_Store
*.log
.idea/
.vscode/
node_modules
/backups/
